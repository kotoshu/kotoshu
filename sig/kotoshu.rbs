module Kotoshu
  VERSION: String

  module Keyboard
    module Layouts
      # Wave-1 national layouts (plan 84); grids mirrored from the
      # models repo eval harness (eval/noise.py).
      class TurkishQ < Layout
        KEY_POSITIONS: Hash[String, [Integer, Integer]]
        def initialize: () -> void
      end

      class Ukrainian < Layout
        KEY_POSITIONS: Hash[String, [Integer, Integer]]
        def initialize: () -> void
      end

      class GreekPhonetic < Layout
        KEY_POSITIONS: Hash[String, [Integer, Integer]]
        def initialize: () -> void
      end

      # Parameterized Latin layout family (plan 84): members declare a
      # name, language codes, a qwerty/qwertz base grid and optional
      # extra physical keys (the Nordic å/æ/ø, å/ä/ö).
      class Latin < Layout
        NOT_SET: Object

        def self.layout_name: (String value) -> String
                              | () -> String?
        def self.languages: (Array[String] value) -> Array[String]
                           | () -> Array[String]?
        def self.base_grid: (Symbol value) -> Symbol
                           | () -> Symbol?
        def self.removed_keys: (Array[String] value) -> Array[String]
                              | () -> Array[String]?
        def self.extra_positions: (Hash[String, [Integer, Integer]] value) -> Hash[String, [Integer, Integer]]
                                 | () -> Hash[String, [Integer, Integer]]?

        def initialize: () -> void

        class Italian < Latin
        end
        class Dutch < Latin
        end
        class Polish < Latin
        end
        class Czech < Latin
        end
        class Hungarian < Latin
        end
        class Romanian < Latin
        end
        class Catalan < Latin
        end
        class Vietnamese < Latin
        end
        class Danish < Latin
        end
        class Norwegian < Latin
        end
        class Swedish < Latin
        end
      end
    end
  end

  module Language
    module Tokenizer
      # Script-aware tokenizers (plan 84).
      class GreekTokenizer < Base
        WORD_SEPARATORS: Regexp

        def initialize: () -> void
        def tokenize: (String? text) -> Array[String]
        def word_boundary_regex: () -> Regexp
        def skip_token?: (String token) -> bool
      end

      class CyrillicTokenizer < Base
        WORD_SEPARATORS: Regexp

        def initialize: () -> void
        def tokenize: (String? text) -> Array[String]
        def word_boundary_regex: () -> Regexp
        def skip_token?: (String token) -> bool
      end
    end

    module Normalizer
      # Greek-aware normalization (plan 84): final-sigma folding and
      # opt-in accent stripping.
      class Greek < Base
        COMBINING_MARKS: Regexp

        def initialize: () -> void
        def normalize: (String? text, ?options ::Hash[Symbol, untyped]) -> String
        def normalize_word: (String word) -> String
      end

      # Turkish case folding (plan 84): I -> ı, İ -> i.
      class Turkish < Base
        def initialize: () -> void
        def normalize: (String? text, ?options ::Hash[Symbol, untyped]) -> String
      end
    end
  end

  module Languages
    # Shared base for the thin wave-1 Latin modules (plan 84).
    class LatinBase < Language::Base
      def initialize: (?code: String code, ?name: String name, ?variant: String? variant) -> void
      def tokenizer: () -> Language::Tokenizer::LatinTokenizer
      def normalizer: () -> Language::Normalizer::Base
      def dictionary_class: () -> Class
      def script_type: () -> :latin
      def create_tokenizer: () -> Language::Tokenizer::Base
      def default_dictionary_paths: () -> Array[String]
    end

    class Catalan < LatinBase
    end
    class Czech < LatinBase
    end
    class Danish < LatinBase
    end
    class Greek < LatinBase
      def tokenizer: () -> Language::Tokenizer::GreekTokenizer
      def normalizer: () -> Language::Normalizer::Greek
      def script_type: () -> :greek
    end
    class Hungarian < LatinBase
    end
    class Italian < LatinBase
    end
    class Dutch < LatinBase
    end
    class Polish < LatinBase
    end
    class Romanian < LatinBase
    end
    class Swedish < LatinBase
    end
    class Turkish < LatinBase
      def normalizer: () -> Language::Normalizer::Turkish
    end
    class Ukrainian < LatinBase
      def tokenizer: () -> Language::Tokenizer::CyrillicTokenizer
      def script_type: () -> :cyrillic
    end
    class Vietnamese < LatinBase
    end
  end

  module Cli
    # .gitignore/.ignore glob-subset matcher (plan 88).
    class IgnoreMatcher
      IGNORE_FILENAMES: Array[String]

      class Pattern
        def initialize: (String line) -> void
        attr_reader source (): String
        attr_reader negated (): bool
        attr_reader dir_only (): bool
        attr_reader regex (): Regexp
        def matches?: (String relative, ?directory: bool directory) -> bool
      end

      def self.load_directory: (String directory) -> IgnoreMatcher
      def self.present_in?: (String directory) -> bool

      def initialize: (Array[String] lines) -> void
      def patterns: () -> Array[Pattern]
      def ignored?: (String relative, ?directory: bool directory) -> bool
    end

    # Directory-tree file selection (plan 88).
    class DirectoryWalker
      TEXT_EXTENSIONS: Array[String]
      DEFAULT_SKIP_DIRS: Array[String]

      def initialize: (?include_globs: Array[String] include_globs, ?exclude_globs: Array[String] exclude_globs) -> void
      def files: (String root) -> Array[String]
    end

    # Multi-target check runner (plan 88).
    class DirectoryCheck
      class FileOutcome < Struct[String path, Models::Result::DocumentResult result, Baseline::Store::Application? application]
      end

      attr_reader outcomes (): Array[FileOutcome]

      def initialize: (Array[String] roots, check: untyped check, ?baseline_path: String? baseline_path,
                       ?include_globs: Array[String] include_globs, ?exclude_globs: Array[String] exclude_globs) -> void
      def run: () -> Array[FileOutcome]
      def file_count: () -> Integer
      def error_count: () -> Integer
      def word_count: () -> Integer
      def failed?: () -> bool
      def suppressed_count: () -> Integer
      def stale_count: () -> Integer
    end
  end

  module Validators
    ACTIVE_MODEL_LOADED: bool

    class ActiveModelUnavailable < Kotoshu::Error
      def initialize: () -> void
    end

    class SpellingValidator
      def initialize: (untyped options) -> void
      def validate_each: (untyped record, untyped attribute, untyped value) -> void
    end
  end

  module Rspec
    module Matchers
      def expect_words: (*String words) -> untyped
      def expect_document: (String path) -> untyped
      def all_be_spelled_correctly: () -> AllWordsSpelledCorrectlyMatcher
      def be_spelled_correctly: (?in: (String | Symbol)? language) -> SpelledCorrectlyMatcher

      class AllWordsSpelledCorrectlyMatcher
        def matches?: (untyped words) -> bool
        def failure_message: () -> String
        def failure_message_when_negated: () -> String
        def description: () -> String
      end

      class SpelledCorrectlyMatcher
        def initialize: (?language: (String | Symbol)? language) -> void
        def matches?: (untyped target) -> bool
        def failure_message: () -> String
        def failure_message_when_negated: () -> String
        def description: () -> String
      end
    end
  end

  module Tasks
    class CheckTask
      include Rake::DSL

      def initialize: (?Symbol name) ?{ (CheckTask task) -> void } -> void
      attr_accessor name (): Symbol
      attr_accessor files (): (untyped)?
      attr_accessor root (): String
      attr_accessor language (): (String | Symbol)?
      attr_accessor fail_on_error (): bool
      attr_accessor baseline_path (): (String)?
      def target_files: () -> Array[String]
    end
  end

  module Jekyll
    JEKYLL_LOADED: bool

    class JekyllUnavailable < Kotoshu::Error
      def initialize: () -> void
    end

    class Generator
      def self.safe: () -> bool
      def self.priority: () -> Symbol
      def generate: (untyped site) -> void
    end
  end

  module Baseline
    class Entry < Lutaml::Model::Serializable
      def initialize: (?file: String?, ?line: Integer, ?word: String, ?count: Integer, **untyped kwargs) -> void
      attr_reader file (): String?
      attr_reader line (): Integer
      attr_reader word (): String
      attr_reader count (): Integer
      def key: () -> [String, String]
    end

    class Store < Lutaml::Model::Serializable
      DEFAULT_FILENAME: String
      CURRENT_VERSION: Integer

      def initialize: (?version: Integer, ?entries: Array[Entry], **untyped kwargs) -> void
      attr_reader version (): Integer
      attr_reader entries (): Array[Entry]

      def self.load: (String path) -> Store
      def self.from_checks: (Hash[String, Array[Models::Result::DocumentResult, String]] checks) -> Store
      def self.canonical_entries: (Array[Entry] entries) -> Array[Entry]

      def save: (String path) -> Store
      def entries_for: (String file) -> Array[Entry]
      def apply: (Models::Result::DocumentResult result, file: String file) -> Application
    end

    # Outcome of applying a Store to one check result (plain Struct).
    class Application
      def result: () -> Models::Result::DocumentResult
      def suppressed_count: () -> Integer
      def stale_count: () -> Integer
      def initialize: (result: Models::Result::DocumentResult result, suppressed_count: Integer suppressed_count, stale_count: Integer stale_count) -> void
    end
  end

  module Documents
    module Suppressions
      def self.scan: (?String? source, ?format: Symbol format) -> Array[Suppression]

      class Suppression
        KINDS: Array[Symbol]

        def initialize: (kind: Symbol kind, directive_line: Integer directive_line, start_line: Integer start_line, end_line: Integer end_line, ?words: Array[String] words) -> void
        attr_reader kind (): Symbol
        attr_reader words (): Array[String]
        attr_reader directive_line (): Integer
        attr_reader start_line (): Integer
        attr_reader end_line (): Integer

        def file_block?: () -> bool
        def covers_line?: (Integer line) -> bool
        def word_scoped?: () -> bool
        def applies_to?: (Integer line, ?word: String? word) -> bool
      end

      class Scanner
        def self.scan: (?String? source, ?format: Symbol format) -> Array[Suppression]
      end
    end
  end
end
